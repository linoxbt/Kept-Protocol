# --- required -------------------------------------------------------------------------------
DATABASE_URL=postgres://user:pass@host:5432/kept

# --- generated on first start and stored in the database (set here only to override) -------
# KEPT_SIGNER_PRIVATE_KEY=0x...     # signs receipts and responses; published in the agent card
# ANCHOR_PRIVATE_KEY=0x...          # EAS anchoring operator; fund its address (see /api/v1/health)
# KEPT_SESSION_SECRET=...
# CRON_SECRET=...                   # GET /api/cron/tick, Authorization: Bearer ...
# Encrypts the stored values above with AES-256-GCM. 64 hex chars; keep it outside the database.
# KEPT_SECRETS_KEK=
# Optional API key for scripts (Authorization: Bearer ...); people use the /admin/setup password.
# KEPT_ADMIN_KEY=

# --- edge proxy (rate limits use the real client IP) ---------------------------------------
# KEPT_EDGE_STRICT=1                # only trust Netlify's client-IP header with the x-kept-edge token
# KEPT_EDGE_TOKEN_SHA256=           # override the token hash committed in src/lib/http.ts

# --- SERV Reasoning (extraction pauses without it; monitoring is unaffected) ------------------
SERV_API_KEY=
SERV_DAILY_BUDGET_USD=5
# SERV_MODEL_LOCATE=gpt-5.4-mini
# SERV_MODEL_EXTRACT=gpt-5.4-mini-serv-kronos
# SERV_MODEL_CLASSIFY=gpt-6-luna-serv-multipath

# --- Base RPC (two independent providers; the second confirms breaches) ------------------
BASE_RPC_URL=https://base-rpc.publicnode.com
BASE_RPC_URL_CONFIRM=https://mainnet.base.org
# Historical requests the primary refuses go to this archive-capable endpoint ("none" to disable).
# BASE_RPC_URL_ARCHIVE=https://base.gateway.tenderly.co
# A paid archive RPC as BASE_RPC_URL (Alchemy, QuickNode) makes long backfills much faster.
# BASE_RPC_MAX_RANGE=50000
# KEPT_MAX_SCAN_BLOCKS=3000000      # blocks scanned per check (backfill resumes on the next check)
# KEPT_MAX_CONFIRM_BLOCKS=3000000   # blocks the second provider recounts per check

# --- x402 agent payments --------------------------------------------------------------------
X402_PAY_TO=0x...
# Production: Base mainnet USDC through PayAI's public facilitator (no account keys needed).
X402_NETWORK=eip155:8453
X402_FACILITATOR_URL=https://facilitator.payai.network
# Testing: X402_NETWORK=eip155:84532 with X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PRICE=$0.01

# --- on-chain anchoring (EAS on Base) ---------------------------------------------------------
# ANCHOR_CHAIN_ID=8453
# ANCHOR_INTERVAL_S=21600          # the worker anchors when funded, at most this often (or at 500 pending)
# EAS_SCHEMA_UID=0x...              # defaults to the deterministic UID of Kept's anchor schema

PUBLIC_BASE_URL=https://your-kept-domain.example
TRYIT_PER_HOUR=5

# --- live-breach demo (scripts/demo.ts) -------------------------------------------------------
# DEMO_CHAIN_ID=84532
# DEMO_DEPLOYER_KEY=0x...
# DEMO_TEAM_KEY=0x...
# DEMO_TOKEN_ADDRESS=0x...

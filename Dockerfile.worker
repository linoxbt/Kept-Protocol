# Long-running monitor (Railway, Fly, any container host). The web app runs next start separately.
FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
ENV NODE_ENV=production
# Node is PID 1 (no shell in between), so SIGTERM reaches the worker's handler and it finishes the
# current tick before exiting. The worker applies migrations itself, then ticks every
# KEPT_TICK_SECONDS. Runs as the unprivileged "node" user.
USER node
CMD ["node", "--import", "tsx", "scripts/worker.ts"]
